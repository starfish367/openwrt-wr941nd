# Put your custom commands here that should be executed once
# the system init finished. By default this file does nothing.

# Enforce fq_codel queue discipline on all network interfaces to kill bufferbloat
for iface in eth0 eth1 wlan0; do
    [ -d "/sys/class/net/$iface" ] && tc qdisc replace dev $iface root fq_codel 2>/dev/null || true
done

# Hardware offload & energy saving disable on radio
iw phy phy0 set power_save off 2>/dev/null || true

exit 0
