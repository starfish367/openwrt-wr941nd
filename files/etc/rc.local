# Enforce fq_codel queue discipline on all network interfaces
for iface in eth0 eth1 wlan0; do
    [ -d "/sys/class/net/$iface" ] && tc qdisc replace dev $iface root fq_codel 2>/dev/null || true
done

# Decompress 17,597 rules into RAM on boot
if [ -f /etc/blocklist.gz ]; then
    mkdir -p /tmp/dnsmasq.d
    zcat /etc/blocklist.gz > /tmp/dnsmasq.d/blocklist.conf
    /etc/init.d/dnsmasq reload 2>/dev/null || true
fi

exit 0
